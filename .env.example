# Sao chép thành .env rồi đổi giá trị. Đây là GIÁ TRỊ MẪU, không phải mật khẩu thật; .env không bao giờ commit.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcrm
# Chạy bằng PostgreSQL cài trên máy: điền tài khoản và mật khẩu PostgreSQL của máy em.
# Chạy bằng Docker: giá trị dưới đây được dùng để tạo CSDL mới trong container, đổi tùy ý.
DB_USER=postgres
DB_PASSWORD=doi_mat_khau_nay

# App
APP_PORT=3000
# Chuỗi bí mật ký token đăng nhập: thay bằng chuỗi dài, ngẫu nhiên, không chia sẻ
# (sinh bằng: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SECRET_KEY=doi_chuoi_bi_mat_nay_thanh_chuoi_ngau_nhien_dai_32_ky_tu
# Mức log: debug | info | warn | error
LOG_LEVEL=info

# Tùy chọn
# Cổng giao diện khi chạy bằng Docker (backend cho phép CORS từ http://localhost:<WEB_PORT>)
WEB_PORT=5173
# CORS_ORIGIN=http://localhost:5173
# SEED_PASSWORD=Mekong@2026
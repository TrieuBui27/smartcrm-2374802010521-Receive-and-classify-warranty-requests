<mxfile host="app.diagrams.net"><diagram name="Kien truc L2" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1120" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Hệ thống Smart CRM – Luồng L2 (một khối triển khai, phân lớp)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#333333;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="15" width="760" height="770" as="geometry"/></mxCell><mxCell id="n3" value="LỚP GIAO DIỆN WEB (Presentation)<br>Trách nhiệm: hiển thị 3 màn hình (danh sách phiếu, tạo phiếu, chi tiết phiếu); kiểm tra nhập liệu cơ bản; gọi API." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="55" width="520" height="110" as="geometry"/></mxCell><mxCell id="n4" value="LỚP CONTROLLER (REST API)<br>Trách nhiệm: nhận request JSON, kiểm tra định dạng/bảng validation, gọi Service, trả mã trạng thái 200/201/400/404/409/422 theo api-contract.md." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="215" width="520" height="110" as="geometry"/></mxCell><mxCell id="n5" value="LỚP SERVICE (nghiệp vụ)<br>Trách nhiệm: CustomerService (QT-01, QT-02), TicketService (QT-03, QT-06, QN-01), WarrantyChecker (QT-05), CategorySuggester (từ khóa), DueDateCalculator (QT-04), che số điện thoại (QT-15) và phân quyền (QT-14). Mở giao dịch cho mỗi thao tác ghi." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="375" width="520" height="165" as="geometry"/></mxCell><mxCell id="n6" value="BỘ LẬP LỊCH<br>Job mỗi 15 phút: đặt is_overdue = true cho phiếu quá hạn (UC9)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="610" y="375" width="150" height="165" as="geometry"/></mxCell><mxCell id="n7" value="LỚP REPOSITORY (truy cập dữ liệu)<br>Trách nhiệm: mọi câu SQL nằm ở đây; ánh xạ dòng ↔ đối tượng; không chứa quy tắc nghiệp vụ." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#6c8ebf;verticalAlign=top;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="590" width="520" height="90" as="geometry"/></mxCell><mxCell id="n8" value="CƠ SỞ DỮ LIỆU PostgreSQL – 6 bảng: customer, device, ticket, issue_category, ticket_status_log, employee" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#6c8ebf;verticalAlign=middle;align=center;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="710" width="520" height="60" as="geometry"/></mxCell><mxCell id="n9" value="NGOÀI PHẠM VI (WON&#x27;T) của BT1<br>• L4: phân công kỹ thuật viên, lịch hẹn<br>• L5: kho linh kiện<br>• L8: khảo sát hài lòng<br>• L10: phân loại bằng học máy (L2 chỉ dùng luật từ khóa)<br>• Thiết kế triển khai và hạ tầng<br>• Mô hình hoá mối đe doạ bảo mật<br>• Đăng nhập chi tiết (giả định đã có, vai trò và trung tâm lấy từ bảng employee)<br>• Gửi SMS/Zalo cho khách" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="15" width="290" height="255" as="geometry"/></mxCell><mxCell id="n10" value="CHÚ THÍCH KÝ HIỆU<br>Khung đậm = ranh giới một khối triển khai<br>Hình chữ nhật màu = một lớp/thành phần, màu khác nhau = lớp khác nhau<br>Mũi tên = chiều gọi (bên gọi → bên được gọi); nhãn trên mũi tên = cách trao đổi<br>Khung nét đứt đỏ = ngoài phạm vi<br><br>Quy tắc phụ thuộc: chỉ gọi xuống lớp kế bên; Controller không gọi Repository trực tiếp; Service không biết HTTP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;verticalAlign=top;align=left;fontSize=10.5;" vertex="1" parent="1"><mxGeometry x="810" y="300" width="290" height="250" as="geometry"/></mxCell><mxCell id="e0" value="HTTPS + JSON (REST)<br>hợp đồng: api-contract.md" style="html=1;rounded=0;fontSize=10;endArrow=open;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="gọi hàm trong cùng tiến trình (DTO)" style="html=1;rounded=0;fontSize=10;endArrow=open;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="gọi hàm" style="html=1;rounded=0;fontSize=10;endArrow=open;" edge="1" parent="1" source="n6" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="gọi hàm (đối tượng miền)" style="html=1;rounded=0;fontSize=10;endArrow=open;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="SQL qua driver, giao dịch ACID" style="html=1;rounded=0;fontSize=10;endArrow=open;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>